# Production Environment
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://agentos:CHANGE_ME@postgres:5432/agentos
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=CHANGE_ME_YOUR_API_KEY
MODEL_NAME=gpt-4-turbo
MAX_TOKENS=4096

# Security (MUST CHANGE IN PRODUCTION)
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Channel Configuration
GATEWAY_PORT=8765
WEB_CHANNEL_PORT=8766
TELEGRAM_BOT_TOKEN=

# Memory Configuration
MEMORY_CONSOLIDATION_INTERVAL=3600
VECTOR_STORE_PATH=/data/chroma

# Self-Evolution
EVOLUTION_SAFE_MODE=true
EVOLUTION_REQUIRE_APPROVAL=true

# Observability
METRICS_RETENTION=86400
ENABLE_TRACING=true
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
MEMORY_WIPE_LIMIT_PER_MINUTE=5

# CORS
CORS_ORIGINS=https://yourdomain.com

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.txt,.pdf,.md,.json,.csv

# Monitoring
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
