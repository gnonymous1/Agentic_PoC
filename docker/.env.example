# =============================================================================
# GNONE — Environment Variable Template
# Copy to .env and fill in real values. NEVER commit .env to version control.
# =============================================================================

# ── Application ────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info

# ── API Keys (Required) ───────────────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Encryption ────────────────────────────────────────────────────────────
# Generate with: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=gnone
POSTGRES_PASSWORD=
POSTGRES_DB=gnone
POSTGRES_EXPOSE_PORT=5432
DATABASE_URL=postgresql://gnone:${POSTGRES_PASSWORD}@postgres:5432/gnone

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_EXPOSE_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ── Nginx ─────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Prometheus ────────────────────────────────────────────────────────────
PROMETHEUS_EXPOSE_PORT=9090

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_EXPOSE_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000

# ── LiveKit ───────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=https://gnone.livekit.cloud

# ── Recall.ai ─────────────────────────────────────────────────────────────
RECALL_AI_API_KEY=
RECALL_AI_BASE_URL=https://api.recall.ai/v1

# ── Webhooks ──────────────────────────────────────────────────────────────
WEBHOOK_SECRET=

# ── OpenTelemetry ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=gnone-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# ── ChromaDB ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=/data/chroma
