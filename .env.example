# Provider Options: openai, google, groq, ollama, openrouter
LLM_PROVIDER=openai

# API Keys
LLM_API_KEY=sk-your-key-here

# Models
# OpenAI: gpt-4-turbo
# Google: gemini-1.5-pro
# Groq: llama3-70b-8192
# Local: local-model-name
MODEL_NAME=gpt-4-turbo

# Optional Base URL (for Local/OpenRouter)
# OpenRouter: https://openrouter.ai/api/v1
# LM Studio: http://localhost:1234/v1
# Ollama: http://localhost:11434/v1
LLM_BASE_URL=
MEMORY_DB_PATH=./chroma_db

# --- Phase 2: Channel System Configuration ---

# Telegram Bot (get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Gateway Server
GATEWAY_PORT=8765
GATEWAY_SECRET_KEY=  # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# Session Management
SESSION_EXPIRY_HOURS=24

# Web Channel
WEB_CHANNEL_PORT=8766
WEB_CHANNEL_ENABLED=true

# Twilio (SMS) - Optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

